# Copy to .env and fill in real values.

# Postgres. Use the direct (non-pooled) URL if migrations misbehave on a pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clerk - Dashboard > API keys. The server refuses to boot without these,
# so a misconfigured deploy fails loudly instead of serving unauthenticated.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
# Clerk > Webhooks > your endpoint > Signing Secret
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Payments. "paystack" (default) or "mock".
# Guards refuse to start if: provider=mock in production, a sk_test_ key in
# production, or CORS_ORIGINS unset in production.
# "paystack" | "moolre". Moolre is the payout-capable rail: Paystack refuses
# third-party transfers on a starter business, so no seller can be paid on it.
PAYMENT_PROVIDER="moolre"
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_CALLBACK_URL="http://localhost:5173/paid"

# Moolre. From the dashboard under "Integrate Our APIs": the account number is
# the wallet, the keys are in the API service's Security section. Both keys are
# needed and they are NOT interchangeable — the hosted checkout link uses the
# public key, while transfers, status lookups, name validation and the wallet
# balance use the private one.
MOOLRE_API_USER=""
MOOLRE_API_KEY=""
MOOLRE_PUBLIC_KEY=""
MOOLRE_ACCOUNT_NUMBER=""
# Echoed inside every callback body. Moolre does not sign the payload, so this
# is the only authentication a webhook carries; the driver refuses every
# callback while it is unset.
MOOLRE_WEBHOOK_SECRET=""
# Set to https://sandbox.moolre.com to run against the sandbox. There are no
# test keys — the host is the only difference, which is why env.ts refuses to
# boot in production with a sandbox URL.
MOOLRE_BASE_URL=""

# Optional. When unset, the key for encrypting payout/refund destinations is
# derived from CLERK_SECRET_KEY by HKDF under its own label. Rotating it makes
# every stored destination unreadable, so sellers would have to re-onboard.
PAYOUT_ENCRYPTION_KEY=""

# Browser origins allowed to call this API. Comma separated. Required in production.
CORS_ORIGINS="http://localhost:5173"

PORT=3000

# Shared secret for the cron job trigger. Required in production.
JOBS_TRIGGER_SECRET="generate-a-long-random-string"

# Email. "smtp", "brevo" or "console". Production refuses "console", because it
# would discard every notification while marking it SENT.
#
# smtp  - any SMTP relay, defaulting to Gmail. Free and needs no signup: use a
#         Google account plus a 16-character App Password (account Security >
#         2-Step Verification > App passwords; requires 2FA on the account, and
#         the account password itself will not work -- Google removed
#         plain-password SMTP in 2022). ~500 recipients/day, and mail arrives
#         "from" that Gmail with no SPF/DKIM for your own domain. A launch
#         bridge, not a transactional service.
# brevo - also free (300/day) and a real transactional service with a sending
#         dashboard. Verifies a single sender with a code emailed to it, so a
#         Gmail address works without owning a domain.
EMAIL_PROVIDER="smtp"

# For EMAIL_PROVIDER=smtp. Host and port default to smtp.gmail.com:465; set
# them for any other relay. Port 587 is the STARTTLS alternative if 465 is
# blocked -- the driver derives TLS mode from the port.
SMTP_USER="you@gmail.com"
SMTP_PASS="abcdefghijklmnop"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=465

# For EMAIL_PROVIDER=brevo.
BREVO_API_KEY="xkeysib-..."

# The sender address. Required for brevo and must be the one you verified.
# Optional for smtp: it falls back to SMTP_USER, which is the only sender Gmail
# will accept anyway.
EMAIL_FROM="you@example.com"
EMAIL_FROM_NAME="Bafle"
# Public URL of the web app; used to build links inside emails.
APP_URL="https://bafle.example.com"

# Cloudinary (Settings > API Keys).
CLOUDINARY_CLOUD_NAME="your-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="..."
